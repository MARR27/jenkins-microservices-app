{
  "service": "user-service",
  "version": "1.0.0",
  "provider": "api-gateway",
  "consumer": "jenkins-pipeline",
  "description": "Contrato entre API Gateway y User Service para validar endpoints principales de usuarios",
  "endpoints": [
    {
      "name": "Listar usuarios",
      "method": "GET",
      "path": "/users",
      "expectedStatuses": [200]
    },
    {
      "name": "Crear usuario",
      "method": "POST",
      "path": "/users",
      "expectedStatuses": [201],
      "requestBody": {
        "name": "Usuario Contrato",
        "email": "contrato@test.com"
      }
    }
  ]
}